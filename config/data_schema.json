{
  "_comment": "Canonical schema references for the Stage 7 research dashboard.",
  "master_dataset": {
    "description": "Monthly regional panel used by the model and dashboard.",
    "primary_key": ["date", "region"],
    "columns": {
      "date": {
        "type": "datetime",
        "frequency": "monthly (month-start)",
        "example": "2010-01-01"
      },
      "region": {
        "type": "string",
        "description": "Standard UK region label used across the project."
      },
      "nominal_house_price": {
        "type": "float",
        "unit": "GBP",
        "description": "Regional average nominal house price."
      },
      "real_house_price": {
        "type": "float",
        "unit": "GBP (real, CPI-adjusted)",
        "description": "Inflation-adjusted regional average house price."
      },
      "hpi_index": {
        "type": "float",
        "description": "HM Land Registry index level."
      },
      "price_to_income_ratio_derived": {
        "type": "float",
        "unit": "ratio",
        "description": "Derived affordability ratio from real prices and real earnings."
      },
      "price_to_income_ratio_official": {
        "type": "float",
        "unit": "ratio",
        "description": "Official affordability ratio series, forward-filled to monthly."
      },
      "mortgage_rate": {
        "type": "float",
        "unit": "percent",
        "description": "Representative mortgage rate used by the model."
      },
      "base_rate": {
        "type": "float",
        "unit": "percent",
        "description": "Bank of England base rate, standardised to monthly."
      },
      "net_additions_monthly": {
        "type": "float",
        "unit": "dwellings",
        "description": "Interpolated housing supply measure."
      },
      "real_annual_earnings": {
        "type": "float",
        "unit": "GBP annual (real)",
        "description": "CPI-deflated regional annual earnings."
      },
      "gross_yield_pct": {
        "type": "float",
        "unit": "percent",
        "description": "Gross rental yield proxy."
      },
      "rental_index": {
        "type": "float",
        "description": "ONS rental index."
      },
      "real_monthly_rent": {
        "type": "float",
        "unit": "GBP monthly (real)",
        "description": "CPI-deflated monthly rent proxy."
      },
      "population": {
        "type": "float",
        "unit": "persons",
        "description": "Interpolated regional population estimate."
      },
      "cpi": {
        "type": "float",
        "description": "Consumer Price Index used for deflation."
      }
    }
  },
  "stage4_parameters": {
    "description": "Stage 4 region-level OLS-to-SDE calibration outputs.",
    "required_columns": ["region", "kappa", "sigma", "mu_equilibrium", "gamma_annual_pp"]
  },
  "stage5_summary": {
    "description": "Stage 5 simulation summary by region and scenario.",
    "required_columns": [
      "scenario",
      "region",
      "median_5yr_growth",
      "p10_5yr_growth",
      "p25_5yr_growth",
      "p75_5yr_growth",
      "p90_5yr_growth",
      "prob_terminal_loss_10pct"
    ]
  },
  "stage6_handoff": {
    "description": "Stage 6 region-level score handoff for the Stage 7 app.",
    "required_columns": [
      "region",
      "consumer_score",
      "consumer_band",
      "reit_score",
      "reit_band",
      "pct_above_pstar",
      "wtd_return_consumer",
      "p_terminal_loss_10_avg"
    ]
  }
}
